{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source-grounded searchable passage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "source_ref",
    "text",
    "locator",
    "usage_status",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^PAS-[0-9]{6}$"
    },
    "source_ref": {
      "type": "string",
      "pattern": "^SRC-[0-9]{6}$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "locator": {
      "type": "string",
      "minLength": 1
    },
    "usage_status": {
      "enum": [
        "original_analysis",
        "licensed_excerpt"
      ]
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "extraction_method": {
      "enum": [
        "human",
        "automated_reviewed"
      ]
    },
    "captured_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "case_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  }
}
