{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Typed relationship",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "subject",
    "predicate",
    "object",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^REL-[0-9]{6}$"
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "predicate": {
      "enum": [
        "investigates",
        "observed_in",
        "supported_by",
        "contradicts",
        "variant_of",
        "same_mechanism_as",
        "requires",
        "derived_from",
        "tests",
        "answers",
        "supersedes",
        "motivated_by",
        "raised_question",
        "pivoted_to",
        "ruled_out_by",
        "abandoned_because",
        "remained_unexplored",
        "challenged_assumption",
        "revised_belief",
        "selected_over",
        "followed_by",
        "informed_by",
        "tested_by",
        "triggered_by",
        "combined_with",
        "blocked_by",
        "failed_because",
        "produced_evidence",
        "supported_assumption",
        "refuted_assumption"
      ]
    },
    "object": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_status",
        "source_refs"
      ],
      "properties": {
        "evidence_status": {
          "type": "string",
          "enum": [
            "unknown",
            "proposed",
            "documented",
            "verified",
            "refuted"
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "causal_basis": {
      "enum": [
        "explicit_documented",
        "reconstructed",
        "temporal_only",
        "counterfactual",
        "unknown"
      ]
    },
    "rationale": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_ref",
          "locator"
        ],
        "properties": {
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "temporal_order": {
      "enum": [
        "before",
        "after",
        "overlap",
        "unknown"
      ]
    }
  }
}
