{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research reasoning event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "case_ref",
    "kind",
    "statement",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^EVT-[0-9]{6}$"
    },
    "case_ref": {
      "type": "string",
      "pattern": "^CASE-[0-9]{6}$"
    },
    "kind": {
      "enum": [
        "observation",
        "assumption",
        "question",
        "hypothesis",
        "experiment",
        "evidence",
        "outcome",
        "principle",
        "direction",
        "decision",
        "pivot",
        "knowledge_revision",
        "blocking_factor",
        "external_input"
      ]
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "previous_event_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_status",
        "source_refs"
      ],
      "properties": {
        "evidence_status": {
          "type": "string",
          "enum": [
            "unknown",
            "proposed",
            "documented",
            "verified",
            "refuted"
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "origin": {
      "enum": [
        "historical",
        "reconstructed",
        "counterfactual",
        "unknown"
      ]
    },
    "timestamps": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "occurred_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "observed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "recorded_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "published_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "known_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "direction_status": {
      "enum": [
        "considered",
        "planned",
        "attempted",
        "not_tested",
        "abandoned",
        "blocked",
        "failed",
        "succeeded",
        "inconclusive",
        "unknown"
      ]
    },
    "result_status": {
      "enum": [
        "success",
        "failure",
        "negative",
        "positive",
        "inconclusive",
        "not_applicable",
        "unknown"
      ]
    },
    "assumption_status": {
      "enum": [
        "assumed",
        "challenged",
        "supported",
        "refuted",
        "revised",
        "unknown"
      ]
    },
    "hindsight_review": {
      "enum": [
        "not_reviewed",
        "passed",
        "failed"
      ]
    },
    "evidence_anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_ref",
          "locator"
        ],
        "properties": {
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "actor": {
      "type": [
        "string",
        "null"
      ]
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "decision_rationale": {
      "type": [
        "string",
        "null"
      ]
    },
    "expected_outcome": {
      "type": [
        "string",
        "null"
      ]
    },
    "actual_outcome": {
      "type": [
        "string",
        "null"
      ]
    },
    "information_gained": {
      "type": [
        "string",
        "null"
      ]
    },
    "blocking_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "assumption_basis": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
