{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research reasoning event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "case_ref",
    "kind",
    "statement",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^EVT-[0-9]{6}$"
    },
    "case_ref": {
      "type": "string",
      "pattern": "^CASE-[0-9]{6}$"
    },
    "kind": {
      "enum": [
        "observation",
        "assumption",
        "question",
        "hypothesis",
        "experiment",
        "evidence",
        "outcome",
        "principle"
      ]
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "previous_event_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_status",
        "source_refs"
      ],
      "properties": {
        "evidence_status": {
          "type": "string",
          "enum": [
            "unknown",
            "proposed",
            "documented",
            "verified",
            "refuted"
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
