{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Investigation case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "source_refs",
    "system_refs",
    "environment_refs",
    "case_kind",
    "analysis_status"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^CASE-[0-9]{6}$"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "system_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "environment_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "finding_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "mechanism_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "context_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "case_kind": {
      "enum": [
        "vulnerability",
        "exploit_chain",
        "architecture",
        "negative_result",
        "failed_investigation",
        "differential",
        "methodology",
        "root_cause",
        "patch_regression",
        "ai_discovery",
        "unclassified"
      ]
    },
    "analysis_status": {
      "enum": [
        "not_started",
        "in_progress",
        "reviewed"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_status",
        "source_refs"
      ],
      "properties": {
        "evidence_status": {
          "type": "string",
          "enum": [
            "unknown",
            "proposed",
            "documented",
            "verified",
            "refuted"
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "legacy_metadata_path": {
      "type": "string",
      "pattern": "^research/cases/CASE-[0-9]{6}/metadata\\.json$"
    },
    "domain_labels": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "discovery_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zero_day_status",
        "evidence_source_refs",
        "independent_verification_refs",
        "review_status",
        "basis"
      ],
      "properties": {
        "zero_day_status": {
          "enum": [
            "unassessed",
            "claimed_zero_day",
            "corroborated_zero_day",
            "not_zero_day",
            "disputed"
          ]
        },
        "evidence_source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^SRC-[0-9]{6}$"
          },
          "uniqueItems": true
        },
        "independent_verification_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^SRC-[0-9]{6}$"
          },
          "uniqueItems": true
        },
        "first_disclosure_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "review_status": {
          "enum": [
            "not_reviewed",
            "reviewed"
          ]
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
